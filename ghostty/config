# Ghostty draws the terminal; tmux owns sessions, windows, and panes.
font-family = JetBrains Mono
font-size = 13
font-feature = -calt
background = #1c1c1c
foreground = #d0d0d0
selection-background = #444444
selection-foreground = #ffffff
cursor-color = #87afff
background-opacity = 1
window-padding-x = 8
window-padding-y = 6
mouse-hide-while-typing = true
macos-option-as-alt = left
clipboard-read = ask
clipboard-write = allow
copy-on-select = false
shell-integration = detect
# Use one tmux layout, not Ghostty tabs/splits. New OS windows remain available.
keybind = super+t=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
# Do not override TERM: Ghostty supplies its actual terminal identity.
